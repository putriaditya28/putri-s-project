  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,700;1,300&display=swap" rel="stylesheet">

  <style>
    :root{
      --bg:#0b0b0d;
      --card:#111114;
      --muted:#a7a7ad;
      --text:#f3f3f6;
      --soft:#1a1a1f;
      --line: rgba(255,255,255,.08);
      --accent:#8B0000;      /* dark red */
      --accent2:#d9d9de;     /* pale */
      --good:#7CFFB2;
      --warn:#FFD27C;
    }

    *{ box-sizing:border-box; }
    html,body{ margin:0; padding:0; background: radial-gradient(1200px 800px at 70% -10%, rgba(139,0,0,.20), transparent 60%),
                                        radial-gradient(900px 700px at 0% 40%, rgba(255,255,255,.06), transparent 55%),
                                        var(--bg);
               color:var(--text);
               font-family:"DM Sans", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
    }

    a{ color:inherit; text-decoration:none; }
    .wrap{ max-width:1100px; margin:0 auto; padding:28px 20px 80px; }

    /* Top minimal bar */
    .topline{
      display:flex; align-items:center; justify-content:space-between;
      gap:12px; padding:10px 0 16px;
      color:rgba(255,255,255,.65);
      font-size:12px; letter-spacing:.10em; text-transform:uppercase;
      border-bottom:1px solid var(--line);
    }
    .topline .pill{
      display:inline-flex; align-items:center; gap:8px;
      background: rgba(255,255,255,.06);
      border:1px solid var(--line);
      padding:8px 12px;
      border-radius:999px;
      white-space:nowrap;
    }
    .dot{ width:6px; height:6px; border-radius:50%; background:var(--accent); display:inline-block; }

    /* Hero */
    .hero{
      margin-top:18px;
      border-radius:22px;
      overflow:hidden;
      border:1px solid var(--line);
      background:
        radial-gradient(1200px 800px at 70% 10%, rgba(139,0,0,.35), transparent 65%),
        linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.02));
      position:relative;
    }
    .hero-inner{ padding:46px 34px 26px; }

    .hero-kicker{
      font-size:12px;
      letter-spacing:.18em;
      text-transform:uppercase;
      color: rgba(255,255,255,.55);
      margin-bottom:14px;
    }
    .hero-title{
      font-family:"Bebas Neue", sans-serif;
      font-size: clamp(52px, 8vw, 90px);
      line-height:.88;
      margin:0;
      letter-spacing:.02em;
    }
    .hero-title .ghost{ color: rgba(255,255,255,.12); }
    .hero-sub{
      margin-top:14px;
      max-width:72ch;
      color: rgba(255,255,255,.72);
      line-height:1.75;
      font-size:14px;
    }

    .hero-meta{
      display:grid;
      grid-template-columns: 1.2fr 1fr 1fr;
      gap:12px;
      margin-top:26px;
      padding-top:18px;
      border-top:1px solid var(--line);
    }
    .meta{
      background: rgba(0,0,0,.20);
      border:1px solid var(--line);
      border-radius:16px;
      padding:14px 14px 12px;
      min-height:76px;
    }
    .meta .label{
      font-size:11px;
      letter-spacing:.12em;
      text-transform:uppercase;
      color: rgba(255,255,255,.48);
      margin-bottom:6px;
    }
    .meta .value{
      font-size:13px;
      color: rgba(255,255,255,.86);
      line-height:1.5;
    }

    /* Sticky nav */
    .nav{
      position:sticky;
      top:0;
      z-index:10;
      margin-top:18px;
      border-radius:16px;
      border:1px solid var(--line);
      background: rgba(11,11,13,.72);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      overflow:auto;
    }
    .nav-inner{
      display:flex;
      gap:0;
      min-width:720px;
    }
    .nav a{
      padding:14px 16px;
      font-size:12px;
      letter-spacing:.12em;
      text-transform:uppercase;
      color: rgba(255,255,255,.60);
      border-right:1px solid var(--line);
      white-space:nowrap;
    }
    .nav a:hover{ background: rgba(255,255,255,.05); color: rgba(255,255,255,.85); }
    .nav a.active{
      background: rgba(139,0,0,.45);
      color: rgba(255,255,255,.95);
    }

    /* Sections */
    section{ margin-top:18px; }
    .grid-2{
      display:grid;
      grid-template-columns: 1.2fr .8fr;
      gap:14px;
    }
    .card{
      background: linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.02));
      border:1px solid var(--line);
      border-radius:18px;
      padding:22px;
    }
    .card.soft{ background: rgba(255,255,255,.03); }
    .label{
      font-size:11px;
      letter-spacing:.16em;
      text-transform:uppercase;
      color: rgba(255,255,255,.55);
      margin-bottom:12px;
    }
    h2{
      margin:0 0 10px;
      font-family:"Bebas Neue", sans-serif;
      font-size:34px;
      letter-spacing:.02em;
      line-height:1.02;
    }
    .p{
      margin:0;
      color: rgba(255,255,255,.74);
      line-height:1.75;
      font-size:14px;
    }

    /* Chips */
    .chips{ display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }
    .chip{
      font-size:12px;
      color: rgba(255,255,255,.78);
      background: rgba(255,255,255,.06);
      border:1px solid var(--line);
      padding:8px 10px;
      border-radius:999px;
    }

    /* Work grid */
    .work-grid{
      display:grid;
      grid-template-columns: repeat(3, 1fr);
      gap:12px;
      margin-top:12px;
    }
    .work{
      border-radius:16px;
      border:1px solid var(--line);
      background: #0f0f13;
      overflow:hidden;
      min-height:170px;
      display:flex;
      flex-direction:column;
      justify-content:space-between;
      position:relative;
    }
    .work::before{
      content:"";
      position:absolute; top:0; left:0; right:0;
      height:3px;
      background: var(--accent);
      opacity:.9;
    }
    .work-top{ padding:16px 16px 10px; }
    .work-client{
      font-size:11px;
      letter-spacing:.14em;
      text-transform:uppercase;
      color: rgba(255,255,255,.40);
      margin-bottom:10px;
    }
    .work-title{
      font-family:"Bebas Neue", sans-serif;
      font-size:20px;
      line-height:1.05;
      letter-spacing:.02em;
      margin:0;
    }
    .work-bottom{
      padding:12px 16px 16px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      border-top:1px solid var(--line);
      color: rgba(255,255,255,.70);
      font-size:12px;
    }
    .tag{
      background: rgba(139,0,0,.38);
      border:1px solid rgba(139,0,0,.55);
      padding:6px 10px;
      border-radius:999px;
      font-size:11px;
      letter-spacing:.10em;
      text-transform:uppercase;
      color: rgba(255,255,255,.85);
      white-space:nowrap;
    }
    .btn{
      display:inline-flex;
      align-items:center;
      gap:10px;
      padding:10px 12px;
      border-radius:12px;
      background: rgba(255,255,255,.06);
      border:1px solid var(--line);
      color: rgba(255,255,255,.85);
    }
    .btn:hover{ background: rgba(255,255,255,.09); }

    /* Tables (simple) */
    .tbl{
      width:100%;
      border-collapse:separate;
      border-spacing:0;
      overflow:hidden;
      border-radius:14px;
      border:1px solid var(--line);
      margin-top:12px;
    }
    .tbl th, .tbl td{
      padding:12px 12px;
      border-bottom:1px solid var(--line);
      font-size:13px;
      vertical-align:top;
    }
    .tbl th{
      text-align:left;
      font-size:11px;
      letter-spacing:.14em;
      text-transform:uppercase;
      color: rgba(255,255,255,.55);
      background: rgba(255,255,255,.04);
    }
    .tbl tr:last-child td{ border-bottom:none; }
    .muted{ color: rgba(255,255,255,.62); }
    .num{ text-align:right; white-space:nowrap; }

    /* Footer contact */
    .contact{
      margin-top:18px;
      border-radius:22px;
      border:1px solid var(--line);
      overflow:hidden;
      background:
        radial-gradient(1200px 700px at 20% 0%, rgba(139,0,0,.35), transparent 60%),
        rgba(255,255,255,.03);
    }
    .contact-inner{
      padding:26px 22px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:16px;
      flex-wrap:wrap;
    }
    .contact h3{
      margin:0;
      font-family:"Bebas Neue", sans-serif;
      font-size:34px;
      line-height:1;
      letter-spacing:.02em;
    }
    .contact .detail{
      color: rgba(255,255,255,.72);
      font-size:14px;
      line-height:1.7;
    }

    /* Responsive */
    @media (max-width: 920px){
      .grid-2{ grid-template-columns:1fr; }
      .work-grid{ grid-template-columns:1fr; }
      .hero-meta{ grid-template-columns:1fr; }
    }
  </style>
</head>

